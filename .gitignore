# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- uv / venv ----
.venv/
venv/
.uv/

# ---- Type checking / linting / test caches ----
.mypy_cache/
.pyright/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Model caches (bge-small, bge-reranker; mounted into Docker) ----
.cache/
models/
.models_cache/
huggingface/
sentence_transformers/

# ---- Eval outputs (reports may embed keys or raw LLM output) ----
evals/reports/*
# ...except the baseline. It is the reference every later run is read against and what Phase 9's
# CI compares to, so a clone without it cannot tell whether a change helped. It holds questions,
# answers and metrics — no keys.
!evals/reports/baseline.json
!evals/reports/baseline.md
!evals/reports/.gitkeep

# ---- Local data / DB dumps ----
*.sqlite
*.db
pgdata/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
