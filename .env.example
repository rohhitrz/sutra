# ---------------------------------------------------------------------------
# Sutra — environment template. Copy to .env and fill in.
# .env is NEVER committed. Keep this file in sync when adding a setting.
#
# Model PRICES are not secrets and live in src/sutra/config.py (MODEL_PRICES),
# so cost accounting stays reproducible and reviewable in git.
# ---------------------------------------------------------------------------

# ---- App ----
APP_ENV=local               # local | ci | prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# Simple shared-secret auth for /v1 (SPEC §6: auth beyond this is a non-goal)
SUTRA_API_KEY=change-me

# ---- Postgres (ADR-002) ----
# Used by the app. Must be the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://sutra:sutra@localhost:5432/sutra
# Used by docker compose to initialise the container.
POSTGRES_USER=sutra
POSTGRES_PASSWORD=sutra
POSTGRES_DB=sutra
POSTGRES_PORT=5432

# ---- LLM provider (ADR-017) ----
OPENAI_API_KEY=sk-proj-...
# Two model roles. Both point at gpt-6-luna for now; Phase 5 may split them.
LLM_FAST=gpt-6-luna
LLM_STRONG=gpt-6-luna
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Fallback chain, tried in order when the primary model fails. Comma-separated.
LLM_FALLBACK_MODELS=gpt-6-luna

# ---- Prompts (ADR-006) ----
# The active version of each prompt. Recorded on every message and trace.
PROMPT_VERSION_ANSWER=v1

# ---- Retrieval / ingestion ----
# Bump to re-ingest without invalidating live traffic or eval baselines.
INDEX_VERSION=1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Mounted as a volume so models download once (ARCHITECTURE §15).
MODEL_CACHE_DIR=./.models_cache

# ---- Semantic cache (ADR-012) ----
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=168

# ---- Observability (ADR-007) — unused until Phase 4 ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACING_ENABLED=false
